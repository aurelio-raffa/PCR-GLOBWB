# ignore cartesius job ouput
*.out

# ignore LSF job files
*.lsf

# ignore LSF job logs (stdout/stderr written by `#BSUB -o/-e` on job end). These hold real cluster
# paths/usernames/hostnames and must never be committed -- see CLAUDE.md "Sensitive information policy".
errfile.*
logfile.*
*.err

# ignore IDE workspace files (contain absolute local paths -- see CLAUDE.md sensitive-info policy)
.idea/
.vscode/

# ignore pcraster maps
*.map
*.ldd

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.cache
nosetests.xml
coverage.xml

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# MLflow & harness
output.log
mlruns/
mlflow.db